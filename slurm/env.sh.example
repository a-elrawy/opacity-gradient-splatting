# Machine-local Compute Canada / Alliance settings.
# Copy to env.sh and edit. Do NOT commit env.sh.
#
#   cp slurm/env.sh.example slurm/env.sh

# Absolute path to this repository on the cluster
export OGS_ROOT="/path/to/opacity-gradient-splatting"

# Python venv with project deps (torch, etc.)
export OGS_VENV="${OGS_ROOT}/fsgs_env"

# SLURM account (Alliance / Compute Canada)
export OGS_ACCOUNT="def-yourpi"

# Optional: override default GPU request used in job scripts
# export OGS_GPU="nvidia_h100_80gb_hbm3_2g.20gb:1"
